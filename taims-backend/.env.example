# ================================
# T-AIMS Backend - Environment Config Template
# ================================

# Server
PORT=3000
NODE_ENV=production

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=taims_user
DB_PASS=taims_password
DB_NAME=taims_db

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES=24h

# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_QOS=1
MQTT_TOPIC_HEARTBEAT=taims/heartbeat
MQTT_TOPIC_ALERT=taims/alert

# API Key untuk Device (Global)
DEVICE_API_KEY=taims_dev_sample_key

# n8n Webhook & Otomasi Workflow
N8N_ALERT_WEBHOOK=http://127.0.0.1:5678/webhook/taims-alert
N8N_RECOVERY_WEBHOOK=http://127.0.0.1:5678/webhook/taims-recovery
N8N_AI_WEBHOOK=http://127.0.0.1:5678/webhook/ai-recommendation
N8N_ACTIVE=true

# Telegram Bot Kredensial
TELEGRAM_BOT_USERNAME=@taims_alert_arik_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=noc-alerts@teknolab.id

# ============================================================
# SMTP Email Dispatcher (Lupa Password & Notifikasi Resmi)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=taims.teknolab.system@gmail.com
SMTP_PASS=
EMAIL_FROM="T-AIMS Security" <noreply@t-aims.teknolab.biz.id>
