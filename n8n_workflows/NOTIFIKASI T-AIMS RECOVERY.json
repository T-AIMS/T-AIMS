      "parameters": {
        "jsCode": "// 1. Ambil payload dari Webhook\nconst raw = $input.first().json;\nconst payload = raw.body || raw;\n\nconst assetCode = payload.asset_code || '-';\nconst assetName = payload.asset_name || '-';\nconst location = payload.location || '-';\nconst ipAddress = payload.ip_address || '-';\n\n// 2. Logika Cooldown Recovery\nconst staticData = $getWorkflowStaticData('global');\nconst COOLDOWN_MS = 10 * 60 * 1000; \nconst now = Date.now();\nconst lastSent = staticData[`last_sent_rec_${assetCode}`] || 0; \n\nif (now - lastSent < COOLDOWN_MS) {\n  return []; \n}\nstaticData[`last_sent_rec_${assetCode}`] = now;\n\n// 3. Format Waktu\nlet timeFormatted = payload.timestamp || payload.recovered_at || '-';\nif (timeFormatted !== '-') {\n  try {\n    timeFormatted = new Date(timeFormatted).toLocaleString('id-ID', {\n      timeZone: 'Asia/Jakarta', dateStyle: 'medium', timeStyle: 'short'\n    }) + ' WIB';\n  } catch (e) {}\n}\n\n// 4. Prompt AI Recovery (Format C dari Wafian)\nconst promptAI = `Kamu adalah AI Network Analyst untuk T-AIMS.\nPerangkat: ${assetName} (${assetCode})\nLokasi: ${location} | IP: ${ipAddress}\nStatus: RESOLVED (ONLINE)\nWaktu Pulih: ${timeFormatted}\n\nTugasmu: Berikan analisis pemulihan.\nGunakan format WAJIB ini (teks biasa, bukan JSON):\n🟢 [T-AIMS RECOVERY] PERANGKAT NORMAL KEMBALI!\n━━━━━━━━━━━━━━━━━━━━\n📌 Aset: ${assetName} (${assetCode})\n🏢 Lokasi: ${location} | 🌐 IP: ${ipAddress}\n📊 Status: RESOLVED (ONLINE)\n⏰ Waktu Pulih: ${timeFormatted}\n\n🤖 Analisis Pemulihan AI:\n[Saran stabilisasi agar tidak putus-nyambung lagi]\n━━━━━━━━━━━━━━━━━━━━\nBot: @taims_alert_arik_bot • n8n Recovery Engine`;\n\n// 5. Fallback Message\nconst messageFallback = `🟢 [T-AIMS RECOVERY] PERANGKAT NORMAL KEMBALI!\n━━━━━━━━━━━━━━━━━━━━\n📌 Aset: ${assetName} (${assetCode})\n🏢 Lokasi: ${location} | 🌐 IP: ${ipAddress}\n📊 Status: RESOLVED (ONLINE)\n⏰ Waktu Pulih: ${timeFormatted}\n\nℹ️ Notifikasi Standar (AI sedang limit/down)\n━━━━━━━━━━━━━━━━━━━━\nBot: @taims_alert_arik_bot • n8n Recovery Engine`;\n\n// 6. Return\nreturn {\n  json: {\n    prompt_ai: promptAI,\n    message: messageFallback,\n    asset_code: assetCode\n  }\n};"
      },
