# ================================
# T-AIMS Backend
# PT Teknolab Caraka Internasional
# ================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database MySQL (sesuaikan dengan kredensial database lokal/server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password_here
DB_NAME=taims_db

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES=24h

# MQTT Broker (untuk integrasi IoT ESP32 & Alerting)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_QOS=1
MQTT_TOPIC_HEARTBEAT=taims/heartbeat
MQTT_TOPIC_ALERT=taims/alert

# API Key untuk Device Ingestion (ESP32 / Monitoring Agent)
DEVICE_API_KEY=your_device_api_key_here
