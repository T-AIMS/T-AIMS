        "jsCode": "// Ambil payload dari MQTT\nconst raw = $input.first().json;\nconst payload = typeof raw.message === 'string' \n  ? JSON.parse(raw.message) \n  : raw.message;\n\n// Ambil static data (cooldown state)\nconst staticData = $getWorkflowStaticData('global');\n\n// Cooldown 10 menit\nconst COOLDOWN_MS = 10 * 60 * 1000;\nconst now = Date.now();\n\n// Cek kapan terakhir kirim notif recovery untuk asset ini\nconst assetCode = payload.asset_code || '-';\nconst lastSent = staticData[`last_recovery_${assetCode}`] || 0;\nconst timeSinceLastSent = now - lastSent;\n\n// Kalau belum lewat cooldown → skip\nif (timeSinceLastSent < COOLDOWN_MS) {\n  return [];\n}\n\n// Update timestamp\nstaticData[`last_recovery_${assetCode}`] = now;\n\n// Kirim data mentah ke AI\nreturn [{\n  json: {\n    asset_code: assetCode,\n    asset_name: payload.asset_name || '-',\n    category: payload.category || '-',\n    recovered_at: payload.recovered_at || '-',\n    timestamp: payload.timestamp || new Date().toISOString()\n  }\n}];"
